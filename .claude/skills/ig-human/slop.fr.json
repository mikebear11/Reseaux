  "structures": [
    {
      "id": "not-just",
      "regex": "(?i)\\bce n['’]est pas (?:seulement |juste |que |qu['’])[^.!?\\n]{2,60}[,.;]\\s*c['’]est\\b",
      "name": "« Ce n'est pas seulement X, c'est Y »",
      "fix": "Dites la seule chose que vous voulez dire. Supprimez la moitié qui prépare."
    },
    {
      "id": "not-only",
      "regex": "(?i)\\bnon seulement\\b[^.!?\\n]{2,80}\\bmais (?:aussi|également|encore)\\b",
      "name": "« Non seulement X mais aussi Y »",
      "fix": "Deux phrases, ou gardez la moitié la plus forte."
    },
    {
      "id": "isnt-about",
      "regex": "(?i)\\bil ne s['’]agit pas (?:seulement |juste )?de [^.!?\\n]{2,60}[,.;]\\s*(?:il s['’]agit|mais)\\b",
      "name": "« Il ne s'agit pas de X, il s'agit de Y »",
      "fix": "Commencez par Y. Le renversement est le signe."
    },
    {
      "id": "the-result",
      "regex": "(?im)^\\s*(?:le résultat|le meilleur|le secret|la suite|le plus fou|le hic|la clé)\\s*\\?\\s*$",
      "name": "Ligne de question rhétorique d'un ou deux mots",
      "fix": "Répondez directement au lieu de mettre en scène une révélation."
    },
    {
      "id": "heres-what",
      "regex": "(?i)\\bvoici ce que (?:j['’]ai|nous avons|on a) appris\\b",
      "name": "« Voici ce que j'ai appris »",
      "fix": "Dites la leçon. Sautez l'annonce."
    },
    {
      "id": "triad",
      "regex": "(?i)\\b\\w+, \\w+ et \\w+\\.",
      "name": "Triade (règle de trois)",
      "fix": "Deux éléments ou quatre. Trois, c'est le rythme par défaut du modèle."
    },
    {
      "id": "rocket",
      "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF]",
      "name": "Emoji fusée / feu / ampoule / étincelles / cible",
      "fix": "Un emoji au maximum, et pas l'un de ces cinq."
    },
    {
      "id": "hashtag-wall",
      "regex": "(?:#\\w+[ \\t]*){6,}",
      "name": "Mur de hashtags (plus de 5)",
      "fix": "5 hashtags maximum, c'est le plafond Instagram depuis le 18/12/2025. Trois bien choisis suffisent."
    },
    {
      "id": "as-an-ai",
      "regex": "(?i)\\ben tant qu['’](?:ia|intelligence artificielle)\\b|\\ben tant que modèle de langage\\b",
      "name": "Le modèle parle de lui-même",
      "fix": "Supprimez la phrase."
    },
    {
      "id": "in-summary",
      "regex": "(?im)^\\s*(?:en conclusion|en résumé|pour conclure|en somme|pour résumer)\\b",
      "name": "Ouverture de conclusion de dissertation",
      "fix": "Un post n'a pas besoin d'un paragraphe de conclusion."
    },
    {
      "id": "engagement-bait",
      "regex": "(?i)(?:d['’]accord\\s?\\?|vous en pensez quoi\\s?\\?|qu['’]en pensez-vous\\s?\\?|qui d['’]autre\\b|j['’]ai tort\\s?\\?)\\s*$",
      "name": "Appât à engagement réflexe",
      "fix": "Posez une question que vous seul pouvez poser, sur le point précis juste au-dessus."
    },
    {
      "id": "stop-scroll",
      "regex": "(?im)^\\s*(?:arr[êe]te[sz]? de scroller|ne scrolle[sz]? pas|attends?,? ne scrolle pas)\\b",
      "name": "Ouverture « arrête de scroller »",
      "fix": "Ce qui arrête le pouce, c'est l'affirmation elle-même. Demander l'attention prouve qu'on ne l'a pas gagnée."
    },
    {
      "id": "in-this-video",
      "regex": "(?i)\\b(?:dans (?:cette|la) vidéo|dans ce reel|aujourd['’]hui,? je vais (?:vous|te)|je vais (?:vous|te) (?:montrer|apprendre|expliquer)|je vous emmène)\\b",
      "name": "Préambule vidéo (« dans cette vidéo je vais vous montrer »)",
      "fix": "Supprimez-le et commencez au résultat. Les deux premières secondes décident du Reel."
    },
    {
